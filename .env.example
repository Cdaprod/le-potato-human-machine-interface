# Local Python install: bind 127.0.0.1. Containers override HMI_HOST to 0.0.0.0.
HMI_HOST=127.0.0.1
HMI_PORT=8080
HMI_MQTT_HOST=127.0.0.1
HMI_MQTT_PORT=1883
HMI_MQTT_USERNAME=
HMI_MQTT_PASSWORD=
HMI_MQTT_TOPIC_PREFIX=benchlab
HMI_MQTT_ENABLED=true
HMI_SERIAL_ENABLED=true
# For docker compose create a local .env and set a long random value.
HMI_API_TOKEN=
